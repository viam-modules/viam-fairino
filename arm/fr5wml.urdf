<?xml version="1.0" ?>
<!-- FAIRINO FR5-WML URDF.
     Kinematics generated from FAIRINO's published FR5-WML Denavit-Hartenberg
     table (Collaborative Robot User Manual, generation 3.9.4); joint limits and
     rated joint velocities from FAIRINO's FR5-WML published specifications.
     See arm/fr5wml_SOURCES.md for source URLs.

     Each DH row is represented as a revolute jN followed by a fixed jN_dh
     transform, so the FAIRINO joint variables map directly to the published DH
     theta terms. The six actuated joints are j1..j6; the interleaved jN_dh
     joints and tool0 are fixed.

     Visual meshes are per-link GLBs (fairino_white body + fairino_orange ring,
     merged from the source package's generated STLs); collision meshes are the
     source package's lower-detail STLs. These are simplified generated meshes,
     not tessellations of FAIRINO's official STEP geometry — they preserve link/
     joint locations and overall scale but not exact castings/covers. -->
<robot name="fairino_fr5_wml">
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/fr5wml/visual/base_link.glb"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/fr5wml/collision/base_link.stl"/>
      </geometry>
    </collision>
  </link>
  <link name="link1">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/fr5wml/visual/link1.glb"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/fr5wml/collision/link1.stl"/>
      </geometry>
    </collision>
  </link>
  <joint name="j1" type="revolute">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="link1"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.054326191" upper="3.054326191" effort="150" velocity="2.094395102"/>
  </joint>
  <link name="frame1"/>
  <joint name="j1_dh" type="fixed">
    <origin xyz="0.180000 0 0.000000" rpy="1.570796327 0 0"/>
    <parent link="link1"/>
    <child link="frame1"/>
  </joint>
  <link name="link2">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/fr5wml/visual/link2.glb"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/fr5wml/collision/link2.stl"/>
      </geometry>
    </collision>
  </link>
  <joint name="j2" type="revolute">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="frame1"/>
    <child link="link2"/>
    <axis xyz="0 0 1"/>
    <limit lower="-4.625122518" upper="1.483529864" effort="150" velocity="2.094395102"/>
  </joint>
  <link name="frame2"/>
  <joint name="j2_dh" type="fixed">
    <origin xyz="0.000000 0 -0.970000" rpy="0.000000000 0 0"/>
    <parent link="link2"/>
    <child link="frame2"/>
  </joint>
  <link name="link3">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/fr5wml/visual/link3.glb"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/fr5wml/collision/link3.stl"/>
      </geometry>
    </collision>
  </link>
  <joint name="j3" type="revolute">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="frame2"/>
    <child link="link3"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.967059728" upper="2.967059728" effort="150" velocity="3.141592654"/>
  </joint>
  <link name="frame3"/>
  <joint name="j3_dh" type="fixed">
    <origin xyz="0.000000 0 -0.816000" rpy="0.000000000 0 0"/>
    <parent link="link3"/>
    <child link="frame3"/>
  </joint>
  <link name="link4">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/fr5wml/visual/link4.glb"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/fr5wml/collision/link4.stl"/>
      </geometry>
    </collision>
  </link>
  <joint name="j4" type="revolute">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="frame3"/>
    <child link="link4"/>
    <axis xyz="0 0 1"/>
    <limit lower="-4.625122518" upper="1.483529864" effort="28" velocity="3.141592654"/>
  </joint>
  <link name="frame4"/>
  <joint name="j4_dh" type="fixed">
    <origin xyz="0.159000 0 0.000000" rpy="1.570796327 0 0"/>
    <parent link="link4"/>
    <child link="frame4"/>
  </joint>
  <link name="link5">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/fr5wml/visual/link5.glb"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/fr5wml/collision/link5.stl"/>
      </geometry>
    </collision>
  </link>
  <joint name="j5" type="revolute">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="frame4"/>
    <child link="link5"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.054326191" upper="3.054326191" effort="28" velocity="3.141592654"/>
  </joint>
  <link name="frame5"/>
  <joint name="j5_dh" type="fixed">
    <origin xyz="0.114000 0 0.000000" rpy="-1.570796327 0 0"/>
    <parent link="link5"/>
    <child link="frame5"/>
  </joint>
  <link name="link6">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/fr5wml/visual/link6.glb"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/fr5wml/collision/link6.stl"/>
      </geometry>
    </collision>
  </link>
  <joint name="j6" type="revolute">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="frame5"/>
    <child link="link6"/>
    <axis xyz="0 0 1"/>
    <limit lower="-6.283185307" upper="6.283185307" effort="28" velocity="3.141592654"/>
  </joint>
  <link name="tool0"/>
  <joint name="j6_dh" type="fixed">
    <origin xyz="0.160000 0 0.000000" rpy="0.000000000 0 0"/>
    <parent link="link6"/>
    <child link="tool0"/>
  </joint>
</robot>
