  <!-- Zero-transform mount frame for attaching an end effector. Replaces the
       original "tool" joint, which pointed at a "gripper_Link" that Fairino
       shipped commented-out with mesh references that don't exist on disk
       anywhere in the source repos. Origin is unchanged from the original
       joint. Named/positioned to match the xarm6 "link_eef" convention.
       Joint name deliberately differs from the link name ("flange_joint" vs
       "flange") — RDK's URDF converter keys a synthetic link entry by a
       fixed joint's own name, then separately overwrites the child link's
       Parent field by looking it up under its own name; giving both the
       same name made that second lookup hit the same map entry the first
       step just created, so its Parent got set to itself — a self-loop RDK
       reported as "infinite loop finding path from end effector to world". -->
  <link name="flange" />
  <joint
    name="flange_joint"
    type="fixed">
    <origin
      xyz="0 0 0"
      rpy="0 0 1.570796" />
    <parent
      link="wrist3_Link" />
    <child
      link="flange" />
  </joint>
